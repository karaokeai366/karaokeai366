# WebSocket signaling server
VITE_SIGNALING_URL=ws://localhost:8787

# URL that other devices should use to join the Host session.
# For local Wi-Fi testing, use the PC's LAN address, for example:
# VITE_PUBLIC_APP_URL=http://192.168.99.23:5173
# In production, set this to the public HTTPS URL of the KaraokeAI web app.
VITE_PUBLIC_APP_URL=
